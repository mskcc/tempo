/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    mskcc/tempo Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Plugins
plugins {
    id 'nf-schema@2.5.0'
}

// Global default params, used in configs
params {
    // Input
    input                      = null

    // References — Tempo is GRCh37-specific for production
    genome                     = null
    fasta                      = null
    fasta_fai                  = null
    dict                       = null
    bwa_index                  = null
    dbsnp                      = null
    dbsnp_tbi                  = null
    known_indels               = null
    known_indels_tbi           = null
    germline_resource          = null
    germline_resource_tbi      = null
    intervals                  = null
    pon                        = null
    pon_tbi                    = null

    // Tempo-specific reference files
    facets_vcf                 = null
    facets_vcf_tbi             = null
    msi_sensor_list            = null
    delly_exclude_regions      = null
    vep_cache                  = null
    vep_cache_version          = null
    species                    = 'homo_sapiens'
    bait_intervals             = null
    target_intervals           = null
    hla_fasta                  = null
    hla_dat                    = null
    neoantigen_cdna            = null
    neoantigen_cds             = null
    snp_gc_corrections         = null
    splice_sites               = null
    sv_blacklist_bed           = null
    sv_blacklist_bedpe         = null
    sv_blacklist_foldback_bedpe = null
    sv_blacklist_te_bedpe      = null
    isoforms                   = null
    vep_custom_isoforms        = null
    coding_bed                 = null
    cosmic_version             = '92'

    // Pipeline control — mirrors original Tempo
    // Comma-separated workflow list: snv,sv,mutsig,lohhla,facets,qc,msisensor,germSNV,germSV
    workflows                  = ''
    assay_type                 = 'exome'   // 'exome' or 'genome'
    aggregate                  = false     // true or path to aggregate TSV
    svcnv                      = 'hisens'  // 'ascat', 'hisens', or 'purity' (WGS SV CNV source)
    cosmic                     = 'v3'      // Cosmic signature version for tempoSig
    outdir                     = null
    publish_dir_mode           = 'copy'
    split_lanes                = true

    // Optional skip flags (only for fine-grained control within enabled workflows)
    skip_multiqc               = false

    // Post-calling annotation references
    repeat_masker              = null
    repeat_masker_tbi          = null
    mapability_blacklist       = null
    mapability_blacklist_tbi   = null
    somatic_pon                = null
    somatic_pon_tbi            = null
    gnomad_somatic             = null
    gnomad_somatic_tbi         = null
    gnomad_germline            = null
    gnomad_germline_tbi        = null
    germline_gnomad_af         = 'INFO/AF > 0.0001'

    // Germline SV calling regions
    call_regions               = null
    call_regions_tbi           = null
    sv_calling_include_regions     = null
    sv_calling_include_regions_tbi = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochromeLogs             = null
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    help_full                  = false
    show_hidden                = false
    version                    = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"

    // Schema validation
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    validationSchemaIgnoreParams = 'genomes,modules_testdata_base_path,pipelines_testdata_base_path'
    validate_params            = true
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_cpus                   = 40
    max_memory                 = '128.GB'
    max_time                   = '336.h'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different Institutions
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        docker.userEmulation    = { ['arm64', 'aarch64'].contains(System.getProperty('os.arch')) }
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
    }
    test                { includeConfig 'conf/test.config'              }
    test_full           { includeConfig 'conf/test_full.config'         }
    test_somatic        { includeConfig 'conf/test_somatic.config'      }
    test_comprehensive  { includeConfig 'conf/test_comprehensive.config' }
    test_wgs            { includeConfig 'conf/test_wgs.config'            }
    juno {
        // MSKCC Juno HPC cluster config (legacy)
        includeConfig 'conf/slurm.config'
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = '/juno/work/tempo/singularity_cache'
    }
    iris {
        // MSKCC IRIS HPC cluster config
        // Uses nf-core institutional config from https://github.com/nf-core/configs
        // See: https://nf-co.re/configs/iris
    }
}

// Set default registry for Apptainer, Docker, Podman, and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Singularity are enabled
// Set to your registry if you have a hierarchical namespace
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'mskcc/tempo'
    author          = """MSKCC Center for Molecular Oncology"""
    homePage        = 'https://github.com/mskcc/tempo'
    description     = """Cancer genomics pipeline for WES/WGS tumor-normal pair analysis"""
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.2'
    version         = '3.0.0dev'
    doi             = ''
}
