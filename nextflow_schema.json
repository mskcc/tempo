{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mskcc/tempo/master/nextflow_schema.json",
  "title": "mskcc/tempo pipeline parameters",
  "description": "TEMPO: Tumor Exome Mutational Profiling in Oncology - Nextflow pipeline for comprehensive tumor sequencing analysis",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/input_output_options"
    },
    {
      "$ref": "#/$defs/reference_genome_options"
    },
    {
      "$ref": "#/$defs/tempo_specific_references"
    },
    {
      "$ref": "#/$defs/pipeline_options"
    },
    {
      "$ref": "#/$defs/skip_options"
    },
    {
      "$ref": "#/$defs/post_calling_references"
    },
    {
      "$ref": "#/$defs/multiqc_options"
    },
    {
      "$ref": "#/$defs/generic_options"
    },
    {
      "$ref": "#/$defs/max_job_request"
    },
    {
      "$ref": "#/$defs/institutional_config_options"
    }
  ],
  "required": [
    "input",
    "outdir"
  ],
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "required": [
        "input",
        "outdir"
      ],
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "description": "Path to comma-separated file containing information about the samples in the experiment.",
          "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with a header line, and a row per sample.",
          "fa_icon": "fas fa-file-csv"
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
          "fa_icon": "fas fa-folder-open"
        }
      }
    },
    "reference_genome_options": {
      "title": "Reference genome options",
      "type": "object",
      "fa_icon": "fas fa-dna",
      "description": "Reference genome and related files for alignment and variant calling.",
      "properties": {
        "genome": {
          "type": "string",
          "description": "Name of iGenomes reference.",
          "help_text": "If using a reference genome configured in the pipeline using iGenomes, use this parameter to give the configured reference name. Possible values are used to initialise the pipeline and cannot be overwritten.",
          "fa_icon": "fas fa-book",
          "enum": [
            "GRCh37",
            "GRCh38",
            "GRCm38",
            "GRCm39",
            "CanFam3.1",
            "BDGP6",
            "R64-1-1",
            "EF2",
            "Mmul_1.0",
            "TAIR10",
            "EB2",
            "UMD3.1",
            "ARS-UCD1.2",
            "V24",
            "Rnor_6.0",
            "Rnor_5.0",
            "CHIMP2.1.4",
            "ATHALIANA_TAIR10",
            "AGPv3",
            "AGPv4",
            "CRBoth",
            "OryCt18",
            "IRGSP-1.0",
            "IWGSC",
            "Amel_4.5",
            "WBcel235",
            "Cfam3.1",
            "Hsap_12"
          ]
        },
        "fasta": {
          "type": "string",
          "format": "file-path",
          "description": "Path to FASTA genome file.",
          "fa_icon": "fas fa-dna"
        },
        "fasta_fai": {
          "type": "string",
          "format": "file-path",
          "description": "Path to FASTA index file.",
          "fa_icon": "fas fa-list"
        },
        "dict": {
          "type": "string",
          "format": "file-path",
          "description": "Path to sequence dictionary file (.dict).",
          "fa_icon": "fas fa-list"
        },
        "bwa_index": {
          "type": "string",
          "format": "directory-path",
          "description": "Path to directory containing BWA index files.",
          "fa_icon": "fas fa-folder"
        },
        "dbsnp": {
          "type": "string",
          "format": "file-path",
          "description": "Path to dbSNP VCF file.",
          "fa_icon": "fas fa-file"
        },
        "dbsnp_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to dbSNP VCF index file.",
          "fa_icon": "fas fa-file"
        },
        "known_indels": {
          "type": "string",
          "format": "file-path",
          "description": "Path to known indels VCF file.",
          "fa_icon": "fas fa-file"
        },
        "known_indels_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to known indels VCF index file.",
          "fa_icon": "fas fa-file"
        },
        "germline_resource": {
          "type": "string",
          "format": "file-path",
          "description": "Path to germline resource VCF file.",
          "fa_icon": "fas fa-file"
        },
        "germline_resource_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to germline resource VCF index file.",
          "fa_icon": "fas fa-file"
        },
        "intervals": {
          "type": "string",
          "format": "file-path",
          "description": "Path to intervals file for variant calling.",
          "fa_icon": "fas fa-file"
        },
        "pon": {
          "type": "string",
          "format": "file-path",
          "description": "Path to Panel of Normals VCF file.",
          "fa_icon": "fas fa-file"
        },
        "pon_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to Panel of Normals VCF index file.",
          "fa_icon": "fas fa-file"
        }
      }
    },
    "tempo_specific_references": {
      "title": "TEMPO-specific reference files",
      "type": "object",
      "fa_icon": "fas fa-book",
      "description": "Reference files specific to TEMPO analysis modules.",
      "properties": {
        "bait_intervals": {
          "type": "string",
          "format": "file-path",
          "description": "Path to bait intervals file for targeted sequencing.",
          "fa_icon": "fas fa-file"
        },
        "target_intervals": {
          "type": "string",
          "format": "file-path",
          "description": "Path to target intervals file for targeted sequencing.",
          "fa_icon": "fas fa-file"
        },
        "species": {
          "type": "string",
          "description": "Species name for VEP annotation.",
          "default": "homo_sapiens",
          "fa_icon": "fas fa-dna"
        },
        "facets_vcf": {
          "type": "string",
          "format": "file-path",
          "description": "Path to FACETS segmentation VCF file.",
          "fa_icon": "fas fa-file"
        },
        "facets_vcf_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to FACETS segmentation VCF index file.",
          "fa_icon": "fas fa-file"
        },
        "msi_sensor_list": {
          "type": "string",
          "format": "file-path",
          "description": "Path to MSI sensor homopolymer list.",
          "fa_icon": "fas fa-file"
        },
        "delly_exclude_regions": {
          "type": "string",
          "format": "file-path",
          "description": "Path to DELLY exclusion regions file.",
          "fa_icon": "fas fa-file"
        },
        "vep_cache": {
          "type": "string",
          "format": "directory-path",
          "description": "Path to directory containing VEP cache files.",
          "fa_icon": "fas fa-folder"
        },
        "vep_cache_version": {
          "type": "string",
          "description": "VEP cache version to use.",
          "fa_icon": "fas fa-tag"
        },
        "hla_fasta": {
          "type": "string",
          "format": "file-path",
          "description": "Path to HLA FASTA reference file.",
          "fa_icon": "fas fa-dna"
        },
        "hla_dat": {
          "type": "string",
          "format": "file-path",
          "description": "Path to HLA typing data file.",
          "fa_icon": "fas fa-file"
        },
        "neoantigen_cdna": {
          "type": "string",
          "format": "file-path",
          "description": "Path to neoantigen cDNA reference file.",
          "fa_icon": "fas fa-dna"
        },
        "neoantigen_cds": {
          "type": "string",
          "format": "file-path",
          "description": "Path to neoantigen CDS reference file.",
          "fa_icon": "fas fa-file"
        },
        "snp_gc_corrections": {
          "type": "string",
          "format": "file-path",
          "description": "Path to SNP GC correction file.",
          "fa_icon": "fas fa-file"
        },
        "splice_sites": {
          "type": "string",
          "format": "file-path",
          "description": "Path to splice sites annotation file.",
          "fa_icon": "fas fa-file"
        },
        "sv_blacklist_bed": {
          "type": "string",
          "format": "file-path",
          "description": "Path to structural variant blacklist BED file.",
          "fa_icon": "fas fa-file"
        },
        "sv_blacklist_bedpe": {
          "type": "string",
          "format": "file-path",
          "description": "Path to structural variant blacklist BEDPE file.",
          "fa_icon": "fas fa-file"
        }
      }
    },
    "pipeline_options": {
      "title": "Pipeline options",
      "type": "object",
      "fa_icon": "fas fa-sliders-h",
      "description": "Configure pipeline behavior and tool selection.",
      "properties": {
        "assay_type": {
          "type": "string",
          "description": "Type of sequencing assay.",
          "default": "exome",
          "enum": [
            "exome",
            "genome"
          ],
          "fa_icon": "fas fa-vial"
        },
        "tools": {
          "type": "string",
          "description": "Tools to run in the pipeline. Use 'all' to run all tools or specify comma-separated list.",
          "default": "all",
          "fa_icon": "fas fa-hammer"
        },
        "publish_dir_mode": {
          "type": "string",
          "description": "Mode for publishing output files.",
          "default": "copy",
          "enum": [
            "symlink",
            "rellink",
            "link",
            "copy",
            "copyNoFollow",
            "move"
          ],
          "fa_icon": "fas fa-copy"
        },
        "split_lanes": {
          "type": "boolean",
          "description": "Split samples by sequencing lane.",
          "default": true,
          "fa_icon": "fas fa-object-group"
        }
      }
    },
    "skip_options": {
      "title": "Skip options",
      "type": "object",
      "fa_icon": "fas fa-ban",
      "description": "Options to skip specific analysis steps.",
      "properties": {
        "skip_alignment": {
          "type": "boolean",
          "description": "Skip alignment step.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_markduplicates": {
          "type": "boolean",
          "description": "Skip mark duplicates step.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_bqsr": {
          "type": "boolean",
          "description": "Skip base quality score recalibration.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_somatic_snv": {
          "type": "boolean",
          "description": "Skip somatic SNV calling.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_somatic_sv": {
          "type": "boolean",
          "description": "Skip somatic structural variant calling.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_germline_snv": {
          "type": "boolean",
          "description": "Skip germline SNV calling.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_germline_sv": {
          "type": "boolean",
          "description": "Skip germline structural variant calling.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_facets": {
          "type": "boolean",
          "description": "Skip FACETS copy number analysis.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_msi": {
          "type": "boolean",
          "description": "Skip MSI analysis.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_lohhla": {
          "type": "boolean",
          "description": "Skip LoH HLA analysis.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_polysolver": {
          "type": "boolean",
          "description": "Skip PolySolver HLA typing.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_neoantigen": {
          "type": "boolean",
          "description": "Skip neoantigen prediction.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_annotation": {
          "type": "boolean",
          "description": "Skip variant annotation step.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_vcf2maf": {
          "type": "boolean",
          "description": "Skip VCF to MAF conversion.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_qc": {
          "type": "boolean",
          "description": "Skip quality control steps.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_multiqc": {
          "type": "boolean",
          "description": "Skip MultiQC report generation.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_somatic_combine": {
          "type": "boolean",
          "description": "Skip somatic variant combine step.",
          "default": false,
          "fa_icon": "fas fa-ban"
        },
        "skip_germline_combine": {
          "type": "boolean",
          "description": "Skip germline variant combine step.",
          "default": false,
          "fa_icon": "fas fa-ban"
        }
      }
    },
    "post_calling_references": {
      "title": "Post-calling annotation references",
      "type": "object",
      "fa_icon": "fas fa-filter",
      "description": "Reference files used for post-calling variant annotation and filtering.",
      "properties": {
        "repeat_masker": {
          "type": "string",
          "format": "file-path",
          "description": "Path to RepeatMasker annotation file.",
          "fa_icon": "fas fa-file"
        },
        "repeat_masker_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to RepeatMasker annotation index file.",
          "fa_icon": "fas fa-file"
        },
        "mapability_blacklist": {
          "type": "string",
          "format": "file-path",
          "description": "Path to mapability blacklist file.",
          "fa_icon": "fas fa-file"
        },
        "mapability_blacklist_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to mapability blacklist index file.",
          "fa_icon": "fas fa-file"
        },
        "somatic_pon": {
          "type": "string",
          "format": "file-path",
          "description": "Path to somatic panel of normals file.",
          "fa_icon": "fas fa-file"
        },
        "somatic_pon_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to somatic panel of normals index file.",
          "fa_icon": "fas fa-file"
        },
        "gnomad_somatic": {
          "type": "string",
          "format": "file-path",
          "description": "Path to gnomAD somatic annotation file.",
          "fa_icon": "fas fa-file"
        },
        "gnomad_somatic_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to gnomAD somatic annotation index file.",
          "fa_icon": "fas fa-file"
        },
        "gnomad_germline": {
          "type": "string",
          "format": "file-path",
          "description": "Path to gnomAD germline annotation file.",
          "fa_icon": "fas fa-file"
        },
        "gnomad_germline_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to gnomAD germline annotation index file.",
          "fa_icon": "fas fa-file"
        },
        "germline_gnomad_af": {
          "type": "string",
          "description": "gnomAD allele frequency filter expression for germline variants.",
          "default": "INFO/AF > 0.0001",
          "fa_icon": "fas fa-filter"
        },
        "call_regions": {
          "type": "string",
          "format": "file-path",
          "description": "Path to BED file of calling regions for germline callers.",
          "fa_icon": "fas fa-file"
        },
        "call_regions_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to calling regions index file.",
          "fa_icon": "fas fa-file"
        },
        "sv_calling_include_regions": {
          "type": "string",
          "format": "file-path",
          "description": "Path to SV calling include regions file.",
          "fa_icon": "fas fa-file"
        },
        "sv_calling_include_regions_tbi": {
          "type": "string",
          "format": "file-path",
          "description": "Path to SV calling include regions index file.",
          "fa_icon": "fas fa-file"
        }
      }
    },
    "multiqc_options": {
      "title": "MultiQC options",
      "type": "object",
      "fa_icon": "fas fa-chart-line",
      "description": "Configure MultiQC report generation.",
      "properties": {
        "multiqc_config": {
          "type": "string",
          "format": "file-path",
          "description": "Path to custom MultiQC configuration file.",
          "fa_icon": "fas fa-cog"
        },
        "multiqc_title": {
          "type": "string",
          "description": "Title for MultiQC report.",
          "fa_icon": "fas fa-heading"
        },
        "multiqc_logo": {
          "type": "string",
          "description": "Logo to include in MultiQC report.",
          "fa_icon": "fas fa-image"
        },
        "max_multiqc_email_size": {
          "type": "string",
          "default": "25.MB",
          "description": "Maximum file size for MultiQC report in emails.",
          "fa_icon": "fas fa-envelope"
        },
        "multiqc_methods_description": {
          "type": "string",
          "description": "Methods description to include in MultiQC report.",
          "fa_icon": "fas fa-book"
        }
      }
    },
    "generic_options": {
      "title": "Generic options",
      "type": "object",
      "fa_icon": "fas fa-file-import",
      "description": "Less common options for the pipeline, typically set in a config file.",
      "properties": {
        "help": {
          "type": "boolean",
          "description": "Display help text.",
          "fa_icon": "fas fa-question-circle",
          "hidden": true
        },
        "help_full": {
          "type": "boolean",
          "description": "Display extended help text.",
          "fa_icon": "fas fa-question-circle",
          "hidden": true
        },
        "show_hidden": {
          "type": "boolean",
          "description": "Show hidden parameters.",
          "fa_icon": "fas fa-eye",
          "hidden": true
        },
        "version": {
          "type": "boolean",
          "description": "Display version and exit.",
          "fa_icon": "fas fa-tags",
          "hidden": true
        },
        "validate_params": {
          "type": "boolean",
          "description": "Boolean to enable/disable parameter validation.",
          "default": true,
          "fa_icon": "fas fa-check-square",
          "hidden": true
        },
        "monochromeLogs": {
          "type": "boolean",
          "description": "Do not use colored output for log statements (deprecated, use monochrome_logs).",
          "fa_icon": "fas fa-palette",
          "hidden": true
        },
        "monochrome_logs": {
          "type": "boolean",
          "description": "Do not use colored output for log statements.",
          "fa_icon": "fas fa-palette",
          "hidden": true
        },
        "hook_url": {
          "type": "string",
          "description": "Execution hook URL for notifications.",
          "fa_icon": "fas fa-link",
          "hidden": true
        },
        "email": {
          "type": "string",
          "description": "Email address for pipeline completion notifications.",
          "fa_icon": "fas fa-envelope",
          "help_text": "Set this parameter to your e-mail address to get a summary e-mail with details about the run sent to you when the workflow exits. If set in your user config file (~/.nextflow/config) then it will always be used."
        },
        "email_on_fail": {
          "type": "string",
          "description": "Email address for pipeline failure notifications.",
          "fa_icon": "fas fa-envelope",
          "help_text": "This works exactly as with `--email`, except emails are only sent if the workflow is not successful."
        },
        "plaintext_email": {
          "type": "boolean",
          "description": "Send plain text email instead of HTML.",
          "fa_icon": "fas fa-envelope",
          "hidden": true
        }
      }
    },
    "max_job_request": {
      "title": "Max job request options",
      "type": "object",
      "fa_icon": "fas fa-microchip",
      "description": "Set the top limit for requested resources for any single job.",
      "help_text": "If you are running on a compute cluster, workers might have a maximum limit on the resources allowed to be requested by a single job. These options allow you to set the max resources requested by the pipeline.",
      "properties": {
        "max_cpus": {
          "type": "integer",
          "description": "Maximum number of CPUs that can be requested for any single job.",
          "default": 40,
          "fa_icon": "fas fa-microchip",
          "help_text": "Use to set an upper-limit for the CPU requirement for each process. Should be an integer e.g. `--max_cpus 1`"
        },
        "max_memory": {
          "type": "string",
          "description": "Maximum amount of memory that can be requested for any single job.",
          "default": "128.GB",
          "fa_icon": "fas fa-memory",
          "pattern": "^\\d+(\\.\\d+)?\\.?\\s*(B|KB|MB|GB|TB)$",
          "help_text": "Use to set an upper-limit for the memory requirement for each process. Should be a string in the format integer-unit e.g. `--max_memory '8.GB'`"
        },
        "max_time": {
          "type": "string",
          "description": "Maximum amount of time that can be requested for any single job.",
          "default": "336.h",
          "fa_icon": "fas fa-hourglass-end",
          "pattern": "^\\d+(\\.\\d+)?\\.?\\s*(ms|s|m|h|d)$",
          "help_text": "Use to set an upper-limit for the time requirement for each process. Should be a string in the format integer-unit e.g. `--max_time '2.h'`"
        }
      }
    },
    "institutional_config_options": {
      "title": "Institutional config options",
      "type": "object",
      "fa_icon": "fas fa-university",
      "description": "Parameters used to describe centralised config profiles. These should not be edited.",
      "properties": {
        "config_profile_name": {
          "type": "string",
          "description": "Institutional config name.",
          "hidden": true,
          "fa_icon": "fas fa-university"
        },
        "config_profile_description": {
          "type": "string",
          "description": "Institutional config description.",
          "hidden": true,
          "fa_icon": "fas fa-university"
        },
        "custom_config_version": {
          "type": "string",
          "description": "Git commit ID for Institutional configs.",
          "default": "master",
          "hidden": true,
          "fa_icon": "fas fa-code-branch",
          "help_text": "Provide git commit id for custom Institutional configs hosted at `https://github.com/nf-core/configs`. This parameter is used to update the remote config."
        },
        "custom_config_base": {
          "type": "string",
          "description": "Base directory for Institutional configs.",
          "default": "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}",
          "hidden": true,
          "fa_icon": "fas fa-server",
          "help_text": "If you're running offline, nextflow will not be able to fetch the institutional config files from the internet. If you have already downloaded the files and know their location on the `sync` host, you can provide an absolute path to instead. For example: `--custom_config_base /path/to/nf-core/configs/`"
        },
        "pipelines_testdata_base_path": {
          "type": "string",
