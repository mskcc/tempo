/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run mskcc/tempo -profile test,<docker/singularity> --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '3.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset using original Tempo test data'

    // Input data - tumor-normal pair samplesheet
    input = "${projectDir}/tests/csv/fastq_tumor_normal_pair.csv"

    // Use smallGRCh37 to bypass runtime reference resolution in main.nf
    genome                = 'smallGRCh37'

    // References - use the original Tempo small test genome (b37-based)
    fasta                 = "${projectDir}/test-data/genome/human_g1k_v37_decoy.small.fasta"
    fasta_fai             = "${projectDir}/test-data/genome/human_g1k_v37_decoy.small.fasta.fai"
    dict                  = "${projectDir}/test-data/genome/human_g1k_v37_decoy.small.dict"
    bwa_index             = "${projectDir}/test-data/genome/human_g1k_v37_decoy.small.fasta"
    dbsnp                 = "${projectDir}/test-data/genome/dbsnp_138.b37.small.vcf"
    dbsnp_tbi             = "${projectDir}/test-data/genome/dbsnp_138.b37.small.vcf.idx"
    known_indels          = "${projectDir}/test-data/genome/Mills_and_1000G_gold_standard.indels.b37.small.vcf"
    known_indels_tbi      = "${projectDir}/test-data/genome/Mills_and_1000G_gold_standard.indels.b37.small.vcf.idx"
    intervals             = "${projectDir}/test-data/genome/small.intervals"

    // Tempo-specific references
    germline_resource     = "${projectDir}/test-data/reference/gnomad/gnomad.exomes.r2.1.1.sites.non_cancer.vcf.gz"
    germline_resource_tbi = "${projectDir}/test-data/reference/gnomad/gnomad.exomes.r2.1.1.sites.non_cancer.vcf.gz.tbi"
    pon                   = "${projectDir}/test-data/genome/pon_test.vcf.gz"
    pon_tbi               = "${projectDir}/test-data/genome/pon_test.vcf.gz.tbi"
    facets_vcf            = null
    msi_sensor_list       = "${projectDir}/test-data/genome/small.msi.list"
    snp_gc_corrections    = "${projectDir}/test-data/genome/SnpGcCorrections.small.tsv"
    delly_exclude_regions = "${projectDir}/test-data/genome/human.hg19.excl.tsv"
    bait_intervals        = "${projectDir}/test-data/genome/IDT_Exome_v1_FP_b37_baits.small.interval_list"
    target_intervals      = "${projectDir}/test-data/genome/IDT_Exome_v1_FP_b37_targets.small.interval_list"
    splice_sites          = "${projectDir}/test-data/reference/annotation/splice_sites.small.bed"

    // Pipeline options
    outdir                = 'results'

    // Minimal test: only somatic SNV calling (Manta + Mutect2 + Strelka2)
    workflows             = 'snv'
    assay_type            = 'exome'
}
