/*
 * -------------------------------------------------
 * Module-specific config (nf-core modules)
 * -------------------------------------------------
 * ext.* directives for modules installed from nf-core/modules,
 * so the module files themselves stay unmodified.
 * -------------------------------------------------
 */

process {
  withName:ABRA2 {
    // --index makes ABRA2 emit a coordinate-sorted BAM plus its <base>.bai,
    // which the downstream RunBQSR process requires.
    ext.args = "--index"
  }
  withName:CUSTOM_FILTEREDGEINDELS {
    // RunBQSR writes ${idSample}.bam, so the default ${meta.id}.bam prefix would collide with its staged input.
    ext.prefix = { "${meta.id}.abra.edgefiltered" }
    publishDir = [
      path:    { "${params.outDir}/bams/${meta.id}/abra2" },
      mode:    params.publishDirMode,
      pattern: "*.edge_indel_{counts.tsv,qnames.txt}"
    ]
  }
}
