/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When condition for module execution.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: true
    ]

    // =============================================
    // RAW READ QC
    // =============================================

    withName: 'FASTQC' {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // =============================================
    // PREPROCESSING
    // =============================================

    withName: 'FASTP' {
        ext.args = [
            '--qualified_quality_phred 15',
            '--length_required 35',
            '--detect_adapter_for_pe'
        ].join(' ')
        publishDir = [
            [
                path: { "${params.outdir}/fastp" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,html}"
            ],
            [
                path: { "${params.outdir}/fastp" },
                mode: params.publish_dir_mode,
                pattern: "*.fastp.fastq.gz",
                enabled: false
            ]
        ]
    }

    // =============================================
    // ALIGNMENT
    // =============================================

    withName: 'BWAMEM2_MEM' {
        ext.args = { "-K 100000000 -Y -R '${meta.read_group}'" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_INDEX_SORTED' {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.merged" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // =============================================
    // MARK DUPLICATES
    // =============================================

    withName: 'GATK4_MARKDUPLICATES' {
        ext.args = '--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500 --ASSUME_SORT_ORDER coordinate --CREATE_INDEX false --MAX_RECORDS_IN_RAM 50000'
        ext.prefix = { "${meta.id}_md" }
        publishDir = [
            [
                path: { "${params.outdir}/alignment/markduplicates" },
                mode: params.publish_dir_mode,
                pattern: "*.metrics"
            ],
            [
                path: { "${params.outdir}/alignment/markduplicates" },
                mode: params.publish_dir_mode,
                pattern: "*.{bam,bai}",
                enabled: false
            ]
        ]
    }

    withName: 'SAMTOOLS_INDEX_MD' {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // =============================================
    // BQSR
    // =============================================

    withName: 'GATK4_BASERECALIBRATOR' {
        publishDir = [
            path: { "${params.outdir}/alignment/bqsr" },
            mode: params.publish_dir_mode,
            pattern: "*.table"
        ]
    }

    withName: 'GATK4_APPLYBQSR' {
        ext.args = '--emit-original-quals'
        ext.prefix = { "${meta.id}.recal" }
        ext.suffix = "bam"
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }

    withName: 'SAMTOOLS_INDEX_RECAL' {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.bai"
        ]
    }

    // =============================================
    // SOMATIC SNV/INDEL CALLING
    // =============================================

    withName: 'GATK4_MUTECT2' {
        ext.args = { "--f1r2-tar-gz ${task.ext.prefix ?: meta.id}.f1r2.tar.gz --normal-sample ${meta.normal_id}" }
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi,stats,f1r2.tar.gz}"
        ]
    }

    withName: 'GETPILEUPSUMMARIES_TUMOR' {
        ext.prefix = { "${meta.id}.tumor" }
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GETPILEUPSUMMARIES_NORMAL' {
        ext.prefix = { "${meta.id}.normal" }
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'GATK4_CALCULATECONTAMINATION' {
        ext.args = { "--tumor-segmentation ${task.ext.prefix ?: meta.id}.segmentation.table" }
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            pattern: "*.{contamination,segmentation}.table"
        ]
    }

    withName: 'GATK4_FILTERMUTECTCALLS' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi,filteringStats.tsv}"
        ]
    }

    // =============================================
    // STRELKA2 + MANTA
    // =============================================

    withName: 'MANTA_SOMATIC' {
        publishDir = [
            path: { "${params.outdir}/somatic/manta" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'STRELKA_SOMATIC' {
        ext.args = '--reportEVSFeatures'
        publishDir = [
            path: { "${params.outdir}/somatic/strelka2" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'GATK4_LEARNREADORIENTATIONMODEL' {
        publishDir = [
            path: { "${params.outdir}/somatic/mutect2" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // =============================================
    // STRUCTURAL VARIANTS
    // =============================================

    withName: 'DELLY_CALL_SOMATIC' {
        publishDir = [
            path: { "${params.outdir}/somatic/delly/per_svtype" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'DELLY_COMBINE' {
        publishDir = [
            path: { "${params.outdir}/somatic/delly" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    // =============================================
    // POST-CALLING PROCESSING (Somatic)
    // =============================================

    withName: 'STRELKA2_COMBINE_SOMATIC' {
        publishDir = [
            path: { "${params.outdir}/somatic/strelka2" },
            mode: params.publish_dir_mode,
            pattern: "*.strelka2.vcf.{gz,gz.tbi}"
        ]
    }

    withName: 'SOMATIC_COMBINE_CHANNEL' {
        publishDir = [
            [
                path: { "${params.outdir}/somatic/${meta.id}/combined_mutations" },
                mode: params.publish_dir_mode,
                pattern: "*.pass.vcf"
            ],
            [
                path: { "${params.outdir}/somatic/${meta.id}/combined_mutations/intermediate_files" },
                mode: params.publish_dir_mode,
                pattern: "*.union.annot.*"
            ]
        ]
    }

    withName: 'SOMATIC_MERGE_SV' {
        publishDir = [
            path: { "${params.outdir}/somatic/${meta.id}/combined_svs" },
            mode: params.publish_dir_mode,
            pattern: "*.delly.manta.vcf.{gz,gz.tbi}"
        ]
    }

    // =============================================
    // GERMLINE SV
    // =============================================

    withName: 'DELLY_CALL_GERMLINE' {
        publishDir = [
            path: { "${params.outdir}/germline/${meta.id}/delly" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'MANTA_GERMLINE' {
        publishDir = [
            path: { "${params.outdir}/germline/${meta.id}/manta" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'GERMLINE_MERGE_SV' {
        publishDir = [
            path: { "${params.outdir}/germline/${meta.id}/combined_svs" },
            mode: params.publish_dir_mode,
            pattern: "*.delly.manta.vcf.{gz,gz.tbi}"
        ]
    }

    // =============================================
    // POST-CALLING PROCESSING (Germline)
    // =============================================

    withName: 'STRELKA2_GERMLINE' {
        publishDir = [
            path: { "${params.outdir}/germline/${meta.id}/strelka2" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'GERMLINE_COMBINE_CHANNEL' {
        publishDir = [
            [
                path: { "${params.outdir}/germline/${meta.normal_id}/combined_mutations" },
                mode: params.publish_dir_mode,
                pattern: "*.germline.vcf*"
            ],
            [
                path: { "${params.outdir}/germline/${meta.normal_id}/combined_mutations/intermediate_files" },
                mode: params.publish_dir_mode,
                pattern: "*.union.*"
            ]
        ]
    }

    // =============================================
    // FACETS
    // =============================================

    withName: 'SNPPILEUP' {
        publishDir = [
            path: { "${params.outdir}/facets" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'FACETS' {
        publishDir = [
            path: { "${params.outdir}/facets" },
            mode: params.publish_dir_mode
        ]
    }

    // =============================================
    // MSI
    // =============================================

    withName: 'MSISENSORPRO_SCAN' {
        publishDir = [
            path: { "${params.outdir}/msi" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'MSISENSORPRO_MSISOMATIC' {
        publishDir = [
            path: { "${params.outdir}/msi" },
            mode: params.publish_dir_mode
        ]
    }

    // =============================================
    // HLA
    // =============================================

    withName: 'POLYSOLVER' {
        publishDir = [
            path: { "${params.outdir}/hla/polysolver" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'LOHHLA' {
        publishDir = [
            path: { "${params.outdir}/hla/lohhla" },
            mode: params.publish_dir_mode,
            pattern: "*.{xls,DNA.HLAlossPrediction_CI.xls}"
        ]
    }

    // =============================================
    // ANNOTATION
    // =============================================

    withName: 'ENSEMBLVEP_VEP' {
        ext.args = [
            '--everything',
            '--filter_common',
            '--per_gene',
            '--total_length',
            '--offline'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/annotation/vep" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'VCF2MAF' {
        publishDir = [
            path: { "${params.outdir}/annotation/maf" },
            mode: params.publish_dir_mode
        ]
    }

    // =============================================
    // GERMLINE
    // =============================================

    withName: 'GATK4_HAPLOTYPECALLER' {
        publishDir = [
            path: { "${params.outdir}/germline" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    // =============================================
    // QC
    // =============================================

    withName: 'PICARD_COLLECTHSMETRICS' {
        publishDir = [
            path: { "${params.outdir}/qc/picard" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QUALIMAP_BAMQC' {
        publishDir = [
            path: { "${params.outdir}/qc/qualimap" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CONPAIR_PILEUP' {
        publishDir = [
            path: { "${params.outdir}/qc/conpair" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'CONPAIR_CONCORDANCE' {
        publishDir = [
            path: { "${params.outdir}/qc/conpair" },
            mode: params.publish_dir_mode
        ]
    }

    // =============================================
    // MULTIQC
    // =============================================

    withName: 'MULTIQC' {
        ext.args = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
