/*
    Test config for WGS-specific pipeline paths (stub mode)
    Extends test_comprehensive.config, sets assay_type to genome
*/

params {
    // ---- WGS mode ----
    assay_type             = 'genome'

    // ---- Enable ALL workflows including mutsig ----
    workflows              = 'snv,sv,mutsig,lohhla,facets,qc,msisensor,germSNV,germSV'
}
